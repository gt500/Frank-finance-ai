# Frank / Zeeder Finance OS — Environment Variables
# Copy this file to .env and fill in your values. .env is gitignored —
# never commit real values, here or anywhere else in the repo.

# ── Safe to expose in the browser bundle (VITE_ prefix) ─────────────────────
# The Supabase anon key is a public identifier, not a secret — every table
# it can touch is protected by Row Level Security (see supabase/migrations).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App config
VITE_APP_NAME=Frank
VITE_APP_VERSION=0.1.0

# Feature flags
VITE_ENABLE_BANK_FEEDS=false        # Set true when a bank aggregator is configured
VITE_ENABLE_SAGE_INTEGRATION=false  # Set true when Sage API credentials added
VITE_ENABLE_SIMPLEPAY=false         # Set true when SimplePay API key is added
VITE_DEMO_MODE=true                 # Uses Wonderland Educare demo data

# Admin PIN for the tenant switcher (Sidebar admin panel) — low-stakes UI
# gate, not a real auth boundary. Still, don't reuse a real password here.
VITE_ADMIN_PIN=

# ── NEVER prefix these with VITE_ — they must never reach the browser ───────
# These are set with `supabase secrets set <NAME>=<value>`, not in this file
# or any .env the frontend reads. Listed here only so you know what to set.
#
# SUPABASE_SERVICE_ROLE_KEY   — bypasses RLS entirely; edge functions only
# ANTHROPIC_API_KEY           — powers chat-message and extract-document
# PAYGATE_3DS_ID / PAYGATE_3DS_KEY
# PAYGATE_MOTO_ID / PAYGATE_MOTO_KEY
# APP_URL                     — used to build PayGate return URLs
# RESEND_API_KEY / BILLING_FROM_EMAIL  — optional, for downgrade emails

# SimplePay (still client-side for now — payroll data, not a payment key)
VITE_SIMPLEPAY_API_KEY=your_simplepay_api_key_here
VITE_SIMPLEPAY_USERNAME=your_simplepay_username_here

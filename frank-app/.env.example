# Frank — Environment Variables
# Copy this file to .env and fill in your values

# Anthropic API Key — get yours at https://console.anthropic.com
# IMPORTANT: In production, never expose this to the browser.
# Use a backend proxy (see docs/DEPLOYMENT.md)
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# App config
VITE_APP_NAME=Frank
VITE_APP_VERSION=0.1.0

# SimplePay API — get your key at https://payroll.simplepay.cloud/external_users
VITE_SIMPLEPAY_API_KEY=your_simplepay_api_key_here
VITE_SIMPLEPAY_USERNAME=your_simplepay_username_here

# Feature flags
VITE_ENABLE_BANK_FEEDS=false        # Set true when Stitch Money is configured
VITE_ENABLE_SAGE_INTEGRATION=false  # Set true when Sage API credentials added
VITE_ENABLE_SIMPLEPAY=false         # Set true when SimplePay API key is added
VITE_DEMO_MODE=true                 # Uses Wonderland Educare demo data
